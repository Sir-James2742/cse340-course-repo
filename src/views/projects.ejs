<%- include('partials/header') %>
    
    <main>
        <h1>Upcoming Service Projects</h1>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    
                    <h2><a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a></h2>
                    
                    <p><a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a></p>
                </li>
                <% }); %>
        </ul>
        <p><a href="/new-project">Add a New Service Project</a></p>
    </main>

    <%- include('partials/footer') %>









