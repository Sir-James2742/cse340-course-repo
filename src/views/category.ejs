<%- include('partials/header') %>
<main>
    <h2>
        <%= category.name %>
    </h2>
    <p>
        <% if (user && user.role_name==='admin' ) { %>
        <a href="/edit-category/<%= category.category_id %>">Edit Category</a>
        <% } %>
    </p>
    <ul>
        <% projects.forEach(project=> { %>
            <li>
                <%= project.title %>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>